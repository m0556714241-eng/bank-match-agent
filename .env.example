# תבנית לקובץ הסביבה - להעתיק לקובץ בשם .env ולמלא את המפתחות
# אין לכתוב מפתחות אמיתיים בקובץ הזה

# Anthropic - מודל השפה
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# LangSmith - מעקב ריצות
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=bank-match-agent

# סביבה: development = בדיקות (איפוס מותר), production = מערכת אמיתית (איפוס חסום)
APP_ENV=development
